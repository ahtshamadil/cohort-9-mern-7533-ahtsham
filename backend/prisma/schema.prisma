// prisma 7's generator. it emits real ES modules, which the old
// prisma-client-js did not, and the backend is "type": "module"
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// prisma 7 no longer takes the connection url here - it comes from
// prisma.config.ts for migrations and from the driver adapter at runtime
datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  notes        Note[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Note {
  id       Int    @id @default(autoincrement())
  title    String
  // Text rather than the default VARCHAR because notes hold rich text
  content  String @db.Text
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
