// prisma 7's generator. it emits real ES modules, which the old
// prisma-client-js did not, and the backend is "type": "module"
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// prisma 7 no longer takes the connection url here - it comes from
// prisma.config.ts for migrations and from the driver adapter at runtime
datasource db {
  provider = "mysql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  // bumped when the password changes, and carried in every token. a token
  // holding an older number stops verifying, which is what logs the other
  // sessions out - a jwt cannot be withdrawn any other way
  tokenVersion Int      @default(0)
  notes        Note[]
  sharedWithMe NoteShare[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Note {
  id          Int    @id @default(autoincrement())
  title       String
  // MediumText rather than Text because rich text markup is several times the
  // size of the words in it, and Text runs out at 65535 bytes
  content     String @db.MediumText
  // the same content with the markup taken out, so search does not match tag names
  contentText String @db.MediumText
  // the owner's pin. sorted on before anything else, so it needs an index
  // alongside the column the list is actually ordered by
  pinned      Boolean @default(false)
  author      User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    Int
  shares      NoteShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, updatedAt])
  @@index([authorId, pinned, updatedAt])
}

// lowercase so the value in the column, the zod enum and the json are one string
enum SharePermission {
  view
  edit
}

model NoteShare {
  id         Int             @id @default(autoincrement())
  note       Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId     Int
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  permission SharePermission @default(view)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // one share per person per note, which is also what lets sharing again upsert
  @@unique([noteId, userId])
  @@index([userId])
}
