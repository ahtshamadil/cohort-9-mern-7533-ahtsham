# Copy to .env and fill in your own values

PORT=4000
NODE_ENV=development

# These match the credentials in docker-compose.yml at the repo root
DATABASE_URL="mysql://root:notes@localhost:3306/notes"
TEST_DATABASE_URL="mysql://root:notes@localhost:3306/notes_test"

# Signs the session tokens. Must be at least 32 characters - generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it logs everybody out, because their existing tokens no longer verify.
JWT_SECRET="replace-me-with-a-generated-32-byte-secret"

# How long a session lasts, in seconds. Defaults to 7 days when unset.
JWT_EXPIRES_IN_SECONDS=604800

# How many proxies sit in front of the API. 0 means none, and the rate limiters
# count by the socket address. Only raise it if a proxy really is there - trusting
# a hop that is not lets a caller set X-Forwarded-For and dodge the limits.
TRUST_PROXY=0
